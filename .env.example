# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Supabase or local). Migrate uses this directly.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/case_atlas_dev?schema=public"
# Only needed locally when running `prisma migrate dev` (Prisma's shadow database).
SHADOW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/case_atlas_shadow?schema=public"

# Supabase project (Phase 1 uses Postgres only; Supabase Auth is optional per CLAUDE.md).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-service-role-key"

# Session/auth secret used to sign session cookies (Session 2). Generate with
# `openssl rand -base64 32`.
SESSION_SECRET="replace-with-a-long-random-string"

# Stripe — launch Phase B (docs/24-railway-launch-runbook.md). Optional for a
# Phase A pilot deploy: with these unset, the billing page runs in pilot mode
# (access comped by an admin) instead of crashing.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_PRICE_ID_AGENT_MONTHLY="price_replace_me"
# Annual plan (~$2,970/yr, ~17% discount) — the annual button only appears once set.
STRIPE_PRICE_ID_AGENT_ANNUAL="price_replace_me"

# Base URL of the deployed app (used for Stripe redirect/portal return URLs).
APP_BASE_URL="http://localhost:3000"

# AI backend (CLAUDE.md's callModel abstraction) — enables free-text
# "I've got a guy" intake parsing. Optional: the structured 10-question form
# works without it. Model ids are overridable; defaults are Haiku for simple
# tasks and Sonnet for complex ones.
ANTHROPIC_API_KEY=""
# AI_MODEL_SIMPLE="claude-haiku-4-5-20251001"
# AI_MODEL_COMPLEX="claude-sonnet-5"

# One-time seed script credentials (prisma/seed.ts). Change after first login.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme123"

# Email delivery (Resend). Unset = emails log to the console (dev/test mode).
# EMAIL_FROM must be on a domain verified in Resend; the resend.dev fallback
# only delivers to the Resend account owner's inbox.
RESEND_API_KEY=""
EMAIL_FROM="Case Atlas <onboarding@resend.dev>"
