// Case Atlas — Phase 1 schema (Skeleton).
// Scope per phase-1-sessions/PHASE-1.md Session 1: users, subscriptions,
// admin_actions, audit_log, and a scenarios stub (fleshed out in Phase 3).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  suspended
}

enum SubscriptionStatus {
  incomplete
  trialing
  active
  past_due
  canceled
}

enum AdminActionType {
  grant
  revoke
  suspend
  reactivate
}

enum TenureBand {
  under_1yr
  yr_1_3
  yr_3_5
  yr_5_10
  yr_10_plus
}

enum IncomeBand {
  under_50k
  band_50k_100k
  band_100k_250k
  band_250k_500k
  over_500k
}

enum InteractionPreference {
  type
  voice
}

enum OutputPreference {
  pdf
  slide_deck
  one_pager
}

enum ReminderFrequency {
  none
  weekly
  daily
}

enum Avatar {
  high_net_worth
  business_owner
  qualified_fund_heavy
  family_legacy
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String?
  role         UserRole   @default(user)
  status       UserStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  subscription        Subscription?
  scenarios           Scenario[]
  adminActionsTaken   AdminAction[]        @relation("AdminActionsTaken")
  adminActionsOn      AdminAction[]        @relation("AdminActionsReceived")
  auditLogEntries     AuditLog[]
  passwordResetTokens PasswordResetToken[]
  agentProfile        AgentProfile?

  @@map("users")
}

// Onboarding profile per docs/03-intake-flow.md section 11 and
// docs/00-developer-brief.md's "Agent onboarding and customization" layer.
// completedAt null = onboarding not yet finished (including skipped).
model AgentProfile {
  id                      String                @id @default(cuid())
  userId                  String                @unique
  user                    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenureBand              TenureBand?
  currentIncomeBand       IncomeBand?
  goalIncome              Int?
  avatarMix               Avatar[]              @default([])
  interactionPreference   InteractionPreference @default(type)
  outputPreference        OutputPreference      @default(pdf)
  reminderFrequency       ReminderFrequency     @default(weekly)
  hasCpaRelationship      Boolean               @default(false)
  hasAttorneyRelationship Boolean               @default(false)
  imoAffiliation          String?
  skipped                 Boolean               @default(false)
  completedAt             DateTime?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@map("agent_profiles")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  status               SubscriptionStatus @default(incomplete)
  plan                 String             @default("agent_monthly_97")
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

model AdminAction {
  id           String          @id @default(cuid())
  adminId      String
  admin        User            @relation("AdminActionsTaken", fields: [adminId], references: [id])
  targetUserId String
  targetUser   User            @relation("AdminActionsReceived", fields: [targetUserId], references: [id])
  action       AdminActionType
  reason       String?
  createdAt    DateTime        @default(now())

  @@map("admin_actions")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("audit_log")
}

// Records every processed Stripe webhook event by its Stripe event id, so a
// retried/duplicate delivery is a no-op instead of double-applying the event.
model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("webhook_events")
}

// Stub only — fleshed out in Phase 3 (The Brain).
model Scenario {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("draft")
  createdAt DateTime @default(now())

  @@map("scenarios")
}
